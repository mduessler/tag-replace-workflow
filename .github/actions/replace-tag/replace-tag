#!/usr/bin/env bash

set -euo pipefail

log_info() {
	echo "[INFO] $*"
}

log_error() {
	echo "[ERROR] $*" >&2
}

verify_environment_variables() {
	if [[ -z "${FILE:-}" ]]; then
		log_error "Environment variable 'FILE' is not set"
		exit 1
	fi
	if [[ -z "${SEARCH:-}" ]]; then
		log_error "Environment variable 'SEARCH' is not set"
		exit 1
	fi
	if [[ -z "${REPLACE:-}" ]]; then
		log_error "Environment variable 'REPLACE' is not set"
		exit 1
	fi
}

main() {
	verify_environment_variables

	if [[ ! -f "${FILE}" ]]; then
		log_error "File ${FILE} not found or is not a file."
		exit 1
	fi
	local changed
	changed="false"

	local output="" line
	while IFS= read -r line || [[ -n "${line}" ]]; do
		if [[ "${line}" == "${SEARCH}" ]]; then
			output+="${REPLACE}"$'\n'
			changed="true"
		else
			output+="${line}"$'\n'
		fi
	done <"${FILE}"

	if [[ "${changed}" == "true" ]]; then
		printf '%s' "${output}" >"${FILE}"
		log_info "Replaced '${SEARCH}' with '${REPLACE}' in ${FILE}"
	else
		log_info "'${SEARCH}' not found in ${FILE} - nothing to do"
	fi
	echo "changed=${changed}" >>"${GITHUB_OUTPUT}"
	exit 0
}

main
